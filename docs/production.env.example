# Referencia para /srv/misgastos/.env; conservar los secretos existentes.
# No copiar sobre el .env local ni cargar desde Git automáticamente.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REEMPLAZAR_POR_LA_CLAVE_EXISTENTE_FUERA_DE_GIT
DJANGO_ALLOWED_HOSTS=misgastos.vetrabyte.com.ar
DATABASE_URL=postgresql://USUARIO:CLAVE_CODIFICADA_URL@127.0.0.1:5432/BASE
GASTIO_FRONTEND_URL=https://misgastos.vetrabyte.com.ar
STATIC_ROOT=/srv/misgastos/static
MEDIA_ROOT=/srv/misgastos/media
# Mismo origen: no necesita excepciones CORS/CSRF.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GASTIO_TERMS_VERSION=
DJANGO_LOG_LEVEL=INFO
# Redis/Celery no son necesarios para los endpoints actuales.
