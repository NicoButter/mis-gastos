# Copy to .env for local development. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is required in every environment, including tests. SQLite is not a
# supported fallback because tenant behaviour must be verified against Postgres.
DATABASE_URL=postgresql://gastio:gastio@127.0.0.1:5432/gastio
DATABASE_TEST_NAME=gastio_test

# The frontend origin used in development. Keep this list explicit.
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Google OAuth 2.0 / OpenID Connect. Leave these blank until the Google Cloud
# web client is configured. They are intentionally never stored in SocialApp.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GASTIO_FRONTEND_URL=http://localhost:4200

# Optional at Phase 0. Celery is configured but no product task depends on it.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Production only: DEBUG=false, an external DJANGO_SECRET_KEY, comma-separated
# hosts/origins, HTTPS enabled at the proxy, and secure cookies.
